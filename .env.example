# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# 管理员接收邮箱（收到客户需求后将自动推送邮件）
ADMIN_EMAIL=1617762195@qq.com

# SMTP 邮件发送配置（推荐 QQ 邮箱，开启后手机微信【QQ邮箱提醒】将秒级收到推送）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=1617762195@qq.com
# QQ 邮箱 16 位 POP3/SMTP 授权码（QQ邮箱网页端 -> 设置 -> 账户 -> 生成授权码）
SMTP_PASS=

# 可选：Server酱个人微信推送 Key（无需发邮件，直接微信公众号模板消息秒弹）
SERVERCHAN_KEY=
